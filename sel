# ====== الواجهة الرئيسية ======
def main():
    banner()
    while True:
        try:
            user_input = input(f"{RED}sel{RESET} > ").strip()
        except (KeyboardInterrupt, EOFError):
            print(f"\n{CYAN}Goodbye.{RESET}")
            sys.exit(0)

        if not user_input:
            continue

        if user_input.lower() in ['exit', 'quit']:
            print(f"{CYAN}Goodbye.{RESET}")
            break
        elif user_input.lower() in ['-h', '--help', 'help']:
            help_menu()
        elif user_input.lower().startswith('sel '):
            query = user_input[4:].strip()
            if query.lower() in ['list', 'all']:
                list_tools()
            else:
                search_and_show(query)
        else:
            # If user types something without 'sel', we can also try to search it directly
            # But to strictly follow, we'll show a message.
            # However, for convenience, we can also search it.
            # Let's just search it.
            search_and_show(user_input)

if __name__ == "__main__":
    main()
