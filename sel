#!/usr/bin/env python3
"""
sel - a pentesting command reference.

I built this because I was tired of googling the same nmap flags
every day. It's a quick lookup tool that stays in the terminal.

Usage:
    sel                  interactive mode
    sel <tool>           show commands for a tool
    sel -l               list every tool
    sel -s <query>       search tools by name/title/tag
    sel -h               show help
"""

import json
import os
import sys
from pathlib import Path
from typing import Dict, List


# -----------------------------------------------------------------------------
# Paths
# -----------------------------------------------------------------------------
SCRIPT_DIR = Path(__file__).resolve().parent
DATA_FILE = SCRIPT_DIR / "tools.json"


# -----------------------------------------------------------------------------
# Colors
# -----------------------------------------------------------------------------
class C:
    RED = "\033[91m"
    GREEN = "\033[92m"
    YELLOW = "\033[93m"
    CYAN = "\033[96m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    RESET = "\033[0m"


# -----------------------------------------------------------------------------
# Banner
# -----------------------------------------------------------------------------
BANNER = r"""
  ███████╗███████╗██╗     ██╗    ██╗ █████╗ ███╗   ██╗██╗███████╗███╗   ███╗
  ██╔════╝██╔════╝██║     ██║    ██║██╔══██╗████╗  ██║██║██╔════╝████╗ ████║
  ███████╗█████╗  ██║     ██║ █╗ ██║███████║██╔██╗ ██║██║███████╗██╔████╔██║
  ╚════██║██╔══╝  ██║     ██║███╗██║██╔══██║██║╚██╗██║██║╚════██║██║╚██╔╝██║
  ███████║███████╗███████╗╚███╔███╔╝██║  ██║██║ ╚████║██║███████║██║ ╚═╝ ██║
  ╚══════╝╚══════╝╚══════╝ ╚══╝╚══╝ ╚═╝  ╚═╝╚═╝  ╚═══╝╚═╝╚══════╝╚═╝     ╚═╝
"""# -----------------------------------------------------------------------------
# Data
# -----------------------------------------------------------------------------
def load_tools() -> Dict[str, dict]:
    if not DATA_FILE.exists():
        print(f"{C.RED}[!] tools.json not found: {DATA_FILE}{C.RESET}")
        sys.exit(1)

    try:
        with DATA_FILE.open("r", encoding="utf-8") as f:
            return json.load(f)
    except json.JSONDecodeError as exc:
        print(f"{C.RED}[!] tools.json is invalid: {exc}{C.RESET}")
        sys.exit(1)


# -----------------------------------------------------------------------------
# Display
# -----------------------------------------------------------------------------
def clear_screen() -> None:
    os.system("cls" if os.name == "nt" else "clear")


def show_banner() -> None:
    clear_screen()
    print(f"{C.RED}{C.BOLD}{BANNER}{C.RESET}")
    print(f"  {C.CYAN}pentesting command reference{C.RESET}  {C.DIM}·  v2.0{C.RESET}")
    print(f"  {C.DIM}{'-' * 68}{C.RESET}\n")


def show_tool(name: str, tool: dict) -> None:
    title = tool["title"]
    print()
    print(f"  {C.GREEN}{C.BOLD}{title}{C.RESET}")
    print(f"  {C.DIM}{'-' * len(title)}{C.RESET}")
    print()

    for index, step in enumerate(tool["steps"], start=1):
        label, command = step
        print(f"  {C.YELLOW}[{index}]{C.RESET} {C.BOLD}{label}{C.RESET}")
        print(f"      {C.CYAN}$ {command}{C.RESET}")

    print()


def show_list(tools: Dict[str, dict]) -> None:
    print(f"\n  {C.BOLD}Available tools ({len(tools)}):{C.RESET}\n")

    current_letter = ""
    for name in sorted(tools.keys()):
        letter = name[0].upper()
        if letter != current_letter:
            print(f"  {C.BOLD}-- {letter} --{C.RESET}")
            current_letter = letter

        title = tools[name]["title"]
        print(f"    {C.CYAN}{name:<22}{C.RESET} {C.DIM}{title}{C.RESET}")

    print()


# -----------------------------------------------------------------------------
# Search
# -----------------------------------------------------------------------------
def search(query: str, tools: Dict[str, dict]) -> List[str]:
    q = query.lower()
    matches = []

    for name, tool in tools.items():
        if q in name.lower():
            matches.append(name)
            continue
        if q in tool["title"].lower():
            matches.append(name)
            continue
        if any(q in tag.lower() for tag in tool.get("tags", [])):
            matches.append(name)

    return matches


# -----------------------------------------------------------------------------
# Help
# -----------------------------------------------------------------------------
def show_help() -> None:
    print(f"""
{C.BOLD}sel - pentesting command reference{C.RESET}

{C.BOLD}USAGE:{C.RESET}
    sel                  interactive mode
    sel <tool>           show commands for a tool
    sel -l               list every tool
    sel -s <query>       search by name, title, or tag
    sel -h               show this help

{C.BOLD}EXAMPLES:{C.RESET}
    sel nmap             # nmap cheatsheet
    sel sqlmap           # sqlmap cheatsheet
    sel -s recon         # everything tagged 'recon'
    sel -s privesc       # everything for privilege escalation

{C.BOLD}ABOUT:{C.RESET}
    Built by Salah Eddin Essbihi.
    Repo: https://github.com/salahreds06-selawy/selwanism
""")


# -----------------------------------------------------------------------------
# Interactive mode
# -----------------------------------------------------------------------------
def interactive(tools: Dict[str, dict]) -> None:
    show_banner()
    print(f"  {C.DIM}Type a tool name, '-l' to list, '-s <x>' to search, 'exit' to quit.{C.RESET}\n")

    while True:
        try:
            raw = input(f"{C.RED}sel{C.RESET} > ").strip()
        except (KeyboardInterrupt, EOFError):
            print(f"\n{C.CYAN}bye{C.RESET}")
            return

        if not raw:
            continue

        lowered = raw.lower()

        if lowered in ("exit", "quit", "q"):
            print(f"{C.CYAN}bye{C.RESET}")
            return

        if lowered in ("-h", "--help", "help"):
            show_help()
            continue

        if lowered in ("-l", "--list", "list"):
            show_list(tools)
            continue

        if lowered.startswith("-s ") or lowered.startswith("search "):
            query = raw.split(" ", 1)[1]
            results = search(query, tools)

            if not results:
                print(f"{C.RED}  no matches for '{query}'{C.RESET}\n")
            elif len(results) == 1:
                show_tool(results[0], tools[results[0]])
            else:
                print(f"\n  {C.GREEN}{len(results)} matches:{C.RESET}")
                for name in results:
                    print(f"    {C.CYAN}{name}{C.RESET}")
                print()
            continue

        if lowered in tools:
            show_tool(lowered, tools[lowered])
            continue

        results = search(raw, tools)

        if len(results) == 1:
            show_tool(results[0], tools[results[0]])
        elif len(results) > 1:
            print(f"\n  {C.GREEN}did you mean:{C.RESET}")
            for name in results[:10]:
                print(f"    {C.CYAN}{name}{C.RESET}")
            print()
        else:
            print(f"{C.RED}  '{raw}' not found. Try -l to list all.{C.RESET}\n")


# -----------------------------------------------------------------------------
# Entry point
# -----------------------------------------------------------------------------
def main() -> int:
    tools = load_tools()
    args = sys.argv[1:]

    if not args:
        interactive(tools)
        return 0

    if len(args) == 1:
        arg = args[0]
        lowered = arg.lower()

        if lowered in ("-h", "--help", "help"):
            show_help()
            return 0

        if lowered in ("-l", "--list", "list"):
            show_list(tools)
            return 0

        if lowered in tools:
            show_tool(lowered, tools[lowered])
            return 0

        results = search(arg, tools)

        if len(results) == 1:
            show_tool(results[0], tools[results[0]])
            return 0

        if results:
            print(f"\n  {C.GREEN}did you mean:{C.RESET}")
            for name in results[:10]:
                print(f"    {C.CYAN}{name}{C.RESET}")
            print()
            return 0

        print(f"{C.RED}  '{arg}' not found. Run 'sel -l' to see all.{C.RESET}")
        return 1

    if args[0] in ("-s", "--search", "search"):
        query = " ".join(args[1:])
        results = search(query, tools)

        if not results:
            print(f"{C.RED}  no matches for '{query}'{C.RESET}")
            return 1

        if len(results) == 1:
            show_tool(results[0], tools[results[0]])
        else:
            print(f"\n  {C.GREEN}{len(results)} matches:{C.RESET}")
            for name in results:
                print(f"    {C.CYAN}{name}{C.RESET}")
            print()
        return 0

    show_help()
    return 1


if __name__ == "__main__":
    sys.exit(main())
