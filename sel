# ====== عرض أداة ======
def show_tool(name):
    if name not in TOOLS:
        return False
    tool = TOOLS[name]
    print(f"\n{GREEN}{BOLD}=== {tool['title']} ==={RESET}")
    print(f"{CYAN}{tool['desc']}{RESET}\n")
    for i, (label, cmd) in enumerate(tool["steps"], 1):
        print(f"  {YELLOW}[{i}]{RESET} {BOLD}{label}{RESET}")
        print(f"      {GREEN}$ {cmd}{RESET}")
    print()
    return True

# ====== البحث ======
def search_and_show(query):
    query = query.lower().strip()
    # If exact key
    if query in TOOLS:
        show_tool(query)
        return
    # Search in keys and titles
    matches = []
    for key, tool in TOOLS.items():
        if query in key.lower() or query in tool["title"].lower() or query in tool["desc"].lower():
            matches.append(key)
    if not matches:
        print(f"{RED}[!] No results for '{query}'{RESET}")
        print(f"{YELLOW}[*] Try 'sel list' to see all available tools.{RESET}\n")
        return
    if len(matches) == 1:
        show_tool(matches[0])
    else:
        print(f"{GREEN}[+] Found {len(matches)} results for '{query}':{RESET}")
        for m in matches:
            print(f"    - {CYAN}{m}{RESET} ({TOOLS[m]['title']})")
        print(f"\n{YELLOW}[*] Type 'sel <name>' to view a specific tool.{RESET}\n")

