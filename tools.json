  "john": {
    "title": "John the Ripper",
    "tags": ["password", "hash"],
    "steps": [
      ["Basic", "john hash.txt"],
      ["With wordlist", "john --wordlist=rockyou.txt hash.txt"],
      ["Show cracked", "john --show hash.txt"],
      ["Unshadow", "unshadow /etc/passwd /etc/shadow > combined.txt"]
    ]
  },
  "hashcat": {
    "title": "Hashcat",
    "tags": ["password", "hash", "gpu"],
    "steps": [
