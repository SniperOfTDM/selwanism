{
  "nmap": {
    "title": "Nmap - Network Scanner",
    "tags": ["recon", "network", "scan"],
    "steps": [
      ["Quick scan", "nmap -sV <IP>"],
      ["Full TCP scan", "nmap -sV -sC -p- -T4 <IP>"],
      ["UDP scan", "nmap -sU --top-ports 100 <IP>"],
      ["OS detection", "nmap -O <IP>"],
      ["Aggressive scan", "nmap -A -T4 <IP>"],
      ["Save output", "nmap -sV -oN scan.txt <IP>"],
      ["Vuln scripts", "nmap --script vuln <IP>"]
    ]
  },
  "masscan": {
    "title": "Masscan - Fast Scanner",
    "tags": ["recon", "network", "scan"],
    "steps": [
      ["All ports", "sudo masscan -p1-65535 <IP> --rate=1000"],
      ["Top 1000", "sudo masscan -p1-1000 <IP> --rate=1000"],
      ["With banners", "sudo masscan -p80,443 <IP> --banners"]
    ]
  },
  "gobuster": {
    "title": "Gobuster - Directory Brute-force",
    "tags": ["web", "directory", "fuzz"],
    "steps": [
      ["Basic dir", "gobuster dir -u http://<IP> -w /usr/share/wordlists/dirb/common.txt"],
      ["With extensions", "gobuster dir -u http://<IP> -w list.txt -x php,html,txt"],
      ["Subdomain", "gobuster dns -d target.com -w subdomains.txt"],
      ["VHOST", "gobuster vhost -u http://<IP> -w vhosts.txt"]
    ]
  },
  "ffuf": {
    "title": "FFuf - Web Fuzzer",
    "tags": ["web", "fuzz", "directory"],
    "steps": [
      ["Directory", "ffuf -u http://<IP>/FUZZ -w /usr/share/wordlists/dirb/common.txt"],
      ["Subdomain", "ffuf -u http://FUZZ.target.com -w subdomains.txt"],
      ["POST param", "ffuf -u http://<IP>/login -X POST -d 'user=FUZZ&pass=test' -w users.txt"]
    ]
  },
  "dirb": {
    "title": "Dirb - Directory Scanner",
    "tags": ["web", "directory"],
    "steps": [
